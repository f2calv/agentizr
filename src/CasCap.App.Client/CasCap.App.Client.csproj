<!-- A server publish for a Linux runtime passes its runtime identifiers globally; the browser client must keep its own. -->
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly" TreatAsLocalProperty="RuntimeIdentifier;RuntimeIdentifiers;SelfContained">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CasCap.Client</RootNamespace>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CasCap.AgentRuntime.Contracts\CasCap.AgentRuntime.Contracts.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\..\..\CasCap.Common\src\CasCap.Common.Configuration.Blazor\CasCap.Common.Configuration.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Pages\RuntimeLoggingSettings.razor.cs" />
    <Content Remove="Pages\RuntimeLoggingSettings.razor" />
    <RazorComponent Remove="Pages\RuntimeLoggingSettings.razor" />
  </ItemGroup>

</Project>
