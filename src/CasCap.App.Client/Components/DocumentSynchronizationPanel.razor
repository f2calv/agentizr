@inherits CancellableComponentBase

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="my-3">
    <MudText Typo="Typo.h6" HtmlTag="h2">1. Discover PDFs in storage</MudText>
    <MudButton OnClick="SynchronizeAsync" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sync"
               Disabled="@(_busy || _result?.Value is not { Enabled: true, Sources.Count: > 0 })">
        Sync documents
    </MudButton>
</MudStack>
<MudText Typo="Typo.body2">Sync checks Blob Storage and registers PDFs. A completed storage scan does not mean document previews have been prepared.</MudText>
@if (_result is null)
{
    <MudProgressLinear Indeterminate="true" aria-label="Loading synchronization status" Class="my-3" />
}
else if (!_result.IsSuccess)
{
    <PageState Status="_result.Status" Errors="_result.Errors" OnRetry="ReloadAsync" />
}
else if (_result.Value is { } synchronization)
{
    @if (!synchronization.Enabled)
    {
        <MudAlert Severity="Severity.Info" Class="my-3">Document synchronization is disabled until the migration and compatible worker rollout are ready.</MudAlert>
    }
    <MudText Typo="Typo.body2">Storage scan schedule: @ScheduleLabel(synchronization.Cron). Sync covers all configured collections in this app. Use Refresh to check progress.</MudText>
    @if (synchronization.Sources.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="my-3">No source containers are configured for this app.</MudAlert>
    }
    <MudStack Spacing="2" Class="my-3">
        @foreach (var source in synchronization.Sources)
        {
            <MudPaper Outlined="true" Class="pa-3" @key="source.SourceId">
                <MudText Typo="Typo.subtitle2">@source.CollectionId: @ScanLabel(source.State)</MudText>
                <MudText Typo="Typo.body2">Latest scan - PDFs added: @source.AddedCount; Work items repaired: @source.RepairedCount; Missing PDFs removed: @source.RemovedCount; Unchanged: @source.UnchangedCount; Conflicts: @source.ConflictCount</MudText>
                <MudText Typo="Typo.body2">Last successful scan: @TimeLabel(source.LastSucceededAtUtc)</MudText>
                <details class="mt-2">
                    <summary>Scan technical details</summary>
                    <MudText Typo="Typo.caption">Source ID: <code>@source.SourceId</code>; scan state: @source.State</MudText>
                </details>
                @if (source.ConflictCount > 0)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-2">Some observations conflicted with concurrent changes or deleted source names. A successful scan does not mean every discrepancy was repaired.</MudAlert>
                }
                @if (source.FailureCode is { } failure)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-2">Last run failed: @failure. Unconfirmed missing sources are not removed.</MudAlert>
                }
            </MudPaper>
        }
    </MudStack>
    <MudText Typo="Typo.h6" HtmlTag="h2">2. Prepare document previews</MudText>
    @if (!synchronization.ProcessingEnabled)
    {
        <MudAlert Severity="Severity.Warning" Class="my-3">
            Preview preparation is paused because document processing is disabled.
            Storage scans can complete successfully while documents remain queued.
            An administrator must configure an approved preparation agent and budgets, then enable processing.
            Sync documents does not prepare previews or enable search.
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Class="my-3">
            Document processing is enabled. Each document still needs preview configuration and a finished preparation job before Preview is available.
            Prepared previews require review and are not searchable.
        </MudAlert>
    }
}
@if (_request is { IsSuccess: true })
{
    <MudAlert Severity="Severity.Info" Class="my-3">Storage scan requested, not completed. The elected worker will handle it; this request does not prepare previews. Use Refresh to check progress.</MudAlert>
}
else if (_request is { } failedRequest)
{
    <PageState Status="failedRequest.Status" Errors="failedRequest.Errors" />
}
