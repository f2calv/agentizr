@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudLink Href="/" Color="Color.Inherit" Typo="Typo.h6" Underline="Underline.None">agentizr administration</MudLink>
        <MudSpacer />
        @if (RuntimeLoggingAvailable)
        {
            <MudLink Href="@RuntimeLoggingRoutes.Page" Color="Color.Inherit" Class="mr-4">Runtime logging</MudLink>
        }
        <SessionStatus />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
</div>
