@page "/apps/{AppId}/agents/{AgentName}"
@inherits CancellableComponentBase

<PageTitle>@AgentName · @AppId · agentizr</PageTitle>

<MudBreadcrumbs Items="Breadcrumbs" />
<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4" HtmlTag="h1">@AgentName</MudText>
    @if (ActiveVersion is { } activeVersion)
    {
        <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Active @activeVersion</MudChip>
    }
    else if (_active?.Status == ApiStatus.NotFound)
    {
        <MudChip T="string" Icon="@Icons.Material.Filled.PauseCircle">Inactive</MudChip>
    }
    <MudSpacer />
    @if (SelectedVersion is { } baseVersion)
    {
        <MudButton Href="@EditPath(baseVersion)" Variant="Variant.Filled" Color="Color.Primary" Disabled="!CanChange">
            New version from @baseVersion
        </MudButton>
    }
    @if (SelectedVersion is { } selectedVersion)
    {
        @if (selectedVersion == ActiveVersion)
        {
            <MudButton OnClick="DeactivateAsync" Variant="Variant.Outlined" Color="Color.Error" Disabled="!CanChange">
                Deactivate @selectedVersion
            </MudButton>
        }
        else
        {
            <MudButton OnClick="() => ActivateAsync(selectedVersion)" Variant="Variant.Outlined" Color="Color.Primary" Disabled="!CanChange">
                Activate @selectedVersion
            </MudButton>
        }
    }
    <MudButton OnClick="ReloadAsync" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_busy">Refresh</MudButton>
</MudStack>

@if (_active is { IsSuccess: false, Status: not ApiStatus.NotFound })
{
    <PageState Status="_active.Status" Errors="_active.Errors" OnRetry="ReloadAsync" />
}

@if (_catalogue is { PublicationSupported: false })
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
        This host reads definitions from configuration, so publishing and activation are unavailable.
    </MudAlert>
}

@if (_history is null)
{
    <MudProgressLinear Indeterminate="true" Class="mt-4" aria-label="Loading definitions" />
}
else if (!_history.IsSuccess)
{
    <PageState Status="_history.Status" Errors="_history.Errors" OnRetry="ReloadAsync" />
}
else
{
    var history = _history.Value!;
    <MudGrid Class="mt-2">
        <MudItem xs="12" md="5">
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.h5" HtmlTag="h2">Versions</MudText>
                <MudSpacer />
                <MudToggleGroup T="DefinitionHistoryFilter" Value="_historyFilter" ValueChanged="HistoryFilterChanged"
                                Size="Size.Small" Outlined="true" aria-label="Show versions">
                    <MudToggleItem Value="DefinitionHistoryFilter.Current" Text="Current" />
                    <MudToggleItem Value="DefinitionHistoryFilter.Archived" Text="Archived" />
                    <MudToggleItem Value="DefinitionHistoryFilter.All" Text="All" />
                </MudToggleGroup>
            </MudStack>
            @if (history.Items.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">
                    @(_historyFilter == DefinitionHistoryFilter.Archived ? "No versions are archived." : "This agent has no published versions.")
                </MudAlert>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th>Version</th>
                            <th>Published</th>
                            <th><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in history.Items)
                        {
                            <tr @key="item.DefinitionVersion" class="@(item.DefinitionVersion == SelectedVersion ? "selected-version" : null)">
                                <td>
                                    <MudLink Href="@VersionPath(item.DefinitionVersion)">@item.DefinitionVersion</MudLink>
                                    @if (item.DefinitionVersion == ActiveVersion)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                                    }
                                    @if (item.IsArchived)
                                    {
                                        <MudChip T="string" Size="Size.Small">Archived</MudChip>
                                    }
                                    <div class="text-secondary">@item.ChangeReason</div>
                                </td>
                                <td>
                                    <span title="@($"Published by {item.PublishedBy ?? "an unknown identity"}")">@Formats.DateTime(item.PublishedAtUtc)</span>
                                    <div class="text-secondary">@DescribeChanges(item)</div>
                                </td>
                                <td>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @if (item.DefinitionVersion != ActiveVersion)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="!CanChange"
                                                       OnClick="() => ActivateAsync(item.DefinitionVersion)">
                                                @(ActiveVersion is null ? "Activate" : "Make active")
                                            </MudButton>
                                            <MudTooltip Text="@(item.IsArchived ? "Restore to the current list" : "Hide from the current list")">
                                                <MudIconButton Size="Size.Small" Disabled="!CanChange"
                                                               Icon="@(item.IsArchived ? Icons.Material.Filled.Unarchive : Icons.Material.Filled.Archive)"
                                                               aria-label="@(item.IsArchived ? $"Restore {item.DefinitionVersion}" : $"Archive {item.DefinitionVersion}")"
                                                               OnClick="() => SetArchivedAsync(item.DefinitionVersion, !item.IsArchived)" />
                                            </MudTooltip>
                                            @if (!item.WasActivated)
                                            {
                                                <MudTooltip Text="Delete permanently; only never-activated versions can be deleted">
                                                    <MudIconButton Size="Size.Small" Color="Color.Error" Disabled="!CanChange"
                                                                   Icon="@Icons.Material.Filled.DeleteForever"
                                                                   aria-label="@($"Delete {item.DefinitionVersion}")"
                                                                   OnClick="() => DeleteVersionAsync(item.DefinitionVersion)" />
                                                </MudTooltip>
                                            }
                                        }
                                    </MudStack>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                @if (HistoryPageCount > 1)
                {
                    <MudPagination Count="HistoryPageCount" Selected="_historyPage" SelectedChanged="HistoryPageChanged"
                                   Size="Size.Small" Class="mt-2" />
                }
            }
        </MudItem>
        <MudItem xs="12" md="7">
            <MudText Typo="Typo.h5" HtmlTag="h2" GutterBottom="true">
                Version @SelectedVersion
                @if (SelectedVersion == ActiveVersion)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                }
                else if (CanChange)
                {
                    <MudChip T="string" Size="Size.Small">Inactive</MudChip>
                }
            </MudText>
            @if (SelectedVersion is null)
            {
                <MudText Typo="Typo.body2">Select a version to see its definition.</MudText>
            }
            else if (_selected is null)
            {
                <MudProgressLinear Indeterminate="true" aria-label="Loading version" />
            }
            else if (!_selected.IsSuccess)
            {
                <PageState Status="_selected.Status" Errors="_selected.Errors" OnRetry="LoadSelectedAsync" />
            }
            else
            {
                var definition = _selected.Value!.Definition;
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><th scope="row">Display name</th><td>@DefinitionJson.GetText(definition, "agent", "name")</td></tr>
                        <tr><th scope="row">Description</th><td>@DefinitionJson.GetText(definition, "agent", "description")</td></tr>
                        <tr><th scope="row">Default prompt</th><td>@DefinitionJson.GetText(definition, "agent", "prompt")</td></tr>
                        <tr><th scope="row">Provider registration</th><td>@DefinitionJson.GetText(definition, "agent", "provider")</td></tr>
                        <tr><th scope="row">Embedded provider</th><td>@DefinitionJson.GetText(definition, "provider", "type"), @(DefinitionJson.GetText(definition, "provider", "endpoint") ?? "provider default endpoint")</td></tr>
                        <tr><th scope="row">Model</th><td>@DefinitionJson.GetText(definition, "provider", "modelName")</td></tr>
                        <tr><th scope="row">Reasoning effort</th><td>@(DefinitionJson.GetText(definition, "provider", "reasoningEffort") ?? "—")</td></tr>
                        <tr><th scope="row">Publication reason</th><td>@_selected.Value.ChangeReason</td></tr>
                    </tbody>
                </MudSimpleTable>
                <MudText Typo="Typo.h6" HtmlTag="h3" Class="mt-4">Instructions</MudText>
                <pre class="definition-text">@DefinitionJson.GetText(definition, "agent", "instructions")</pre>
                <MudText Typo="Typo.h6" HtmlTag="h3" Class="mt-4">Tools and delegation</MudText>
                <pre class="definition-text">@DefinitionJson.GetToolsJson(definition)</pre>
                @if (DefinitionJson.GetRealtimeJson(definition) is { } realtimeJson)
                {
                    <MudText Typo="Typo.h6" HtmlTag="h3" Class="mt-4">Realtime voice calls</MudText>
                    <pre class="definition-text">@realtimeJson</pre>
                }
            }
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-6" GutterBottom="true">Activation history</MudText>
    @if (_activations is { IsSuccess: true, Value: { Count: > 0 } activations })
    {
        <MudSimpleTable Dense="true">
            <thead>
                <tr><th>When</th><th>Change</th><th>By</th><th>Reason</th></tr>
            </thead>
            <tbody>
                @foreach (var activation in activations)
                {
                    <tr @key="(activation.DefinitionVersion, activation.ActivatedAtUtc)">
                        <td>@Formats.DateTime(activation.ActivatedAtUtc)</td>
                        <td>@(activation.IsDeactivation ? $"Deactivated {activation.DefinitionVersion}" : $"Activated {activation.DefinitionVersion}")</td>
                        <td>@activation.ActivatedBy</td>
                        <td>@activation.ChangeReason</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
    else
    {
        <MudText Typo="Typo.body2">No activation changes have been recorded.</MudText>
    }
}
