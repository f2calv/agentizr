<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["agentizr.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="BrowserOnly" />
</head>

<body>
    <CasCap.Client.Routes @rendermode="BrowserOnly" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    // The client runs only in the browser: no prerendering, so components never need server data paths.
    private static readonly IComponentRenderMode BrowserOnly = new InteractiveWebAssemblyRenderMode(prerender: false);
}
