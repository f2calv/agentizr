<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>agentizr</AssemblyName>
    <!-- Brings blazor.web.js; the SDK infers it from .razor files, which container restores run without. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CasCap.App.Server.Tests" />
    <ProjectReference Include="..\CasCap.App.Client\CasCap.App.Client.csproj" />
    <ProjectReference Include="..\CasCap.AgentRuntime.Contracts\CasCap.AgentRuntime.Contracts.csproj" />
    <ProjectReference Include="..\CasCap.AgentRuntime.Execution\CasCap.AgentRuntime.Execution.csproj" />
    <ProjectReference Include="..\CasCap.AgentRuntime.Evaluation\CasCap.AgentRuntime.Evaluation.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="Always" />
    <Content Include="..\..\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="Always" />
    <Content Include="..\..\appsettings.Local.json" Link="appsettings.Local.json" CopyToOutputDirectory="Always" Condition="Exists('..\..\appsettings.Local.json')" CopyToPublishDirectory="Never" Pack="false" />
    <Content Include="..\..\appsettings.Local.Development.json" Link="appsettings.Local.Development.json" CopyToOutputDirectory="Always" Condition="Exists('..\..\appsettings.Local.Development.json')" CopyToPublishDirectory="Never" Pack="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)'=='Release'">
    <!-- TODO: Promote the soak to Release when its Common packages are published; keep Release on real package versions until then. -->
    <Compile Remove="AppHost.RuntimeConfiguration.cs;RuntimeConfiguration\**\*.cs" />
    <!-- TODO: Enable ingestion in Release after the shared Event Grid parser and leadership APIs are published. -->
    <Compile Remove="Models\_DocumentIngestionConfig.cs;Models\DocumentIngestionNotification.cs;Models\IngestionQueueMessage.cs;Abstractions\IDocumentIngestionEventQueue.cs;Abstractions\IDocumentIngestionInbox.cs;Services\AzureDocumentIngestionQueue.cs;Services\DocumentIngestionAdmissionService.cs;Services\DocumentIngestionInboxService.cs;Services\DocumentIngestionFeature.cs" />
    <Compile Remove="Models\_Enums.cs;Models\DocumentIngestionClaim.cs;Abstractions\IDocumentProcessor.cs;Services\DocumentIngestionJobService.cs;Services\DocumentIngestionProcessingService.cs;Services\DocumentIngestionTransactions.cs" />
    <PackageReference Include="CasCap.Api.Azure.Auth" />
    <PackageReference Include="CasCap.Common.Caching" />
    <PackageReference Include="CasCap.Common.Configuration" />
    <PackageReference Include="CasCap.Common.Hosting.AspNetCore" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)'!='Release'">
    <ProjectReference Include="..\..\..\CasCap.Api.Azure\src\CasCap.Api.Azure.EventGrid\CasCap.Api.Azure.EventGrid.csproj" />
    <ProjectReference Include="..\..\..\CasCap.Api.Azure\src\CasCap.Api.Azure.Storage\CasCap.Api.Azure.Storage.csproj" />
    <ProjectReference Include="..\..\..\CasCap.Common\src\CasCap.Common.Configuration.PostgreSql\CasCap.Common.Configuration.PostgreSql.csproj" />
    <ProjectReference Include="..\..\..\CasCap.Api.Azure\src\CasCap.Api.Azure.Auth\CasCap.Api.Azure.Auth.csproj" />
    <ProjectReference Include="..\..\..\CasCap.Common\src\CasCap.Common.Caching\CasCap.Common.Caching.csproj" />
    <ProjectReference Include="..\..\..\CasCap.Common\src\CasCap.Common.Configuration\CasCap.Common.Configuration.csproj" />
    <ProjectReference Include="..\..\..\CasCap.Common\src\CasCap.Common.Hosting.AspNetCore\CasCap.Common.Hosting.AspNetCore.csproj" />
  </ItemGroup>

</Project>
